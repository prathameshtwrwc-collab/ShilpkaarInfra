# ── Database (PostgreSQL) ──────────────────────────────────────────────
# On Vercel: Project → Storage → Create Database → Neon → Connect.
# That sets both variables automatically. Locally, paste the same values
# (a free Neon project or Neon "branch" works well for development).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# ── Security ──────────────────────────────────────────────────────────
# 32+ random characters each:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
IP_HASH_SALT=""
SITE_URL="https://your-domain.example"

# ── Media storage ─────────────────────────────────────────────────────
# Vercel Blob (recommended on Vercel): Project → Storage → Create → Blob → Connect.
# It sets BLOB_READ_WRITE_TOKEN; the app then uses Blob automatically.
BLOB_READ_WRITE_TOKEN=""
# Alternatives: STORAGE_DRIVER="s3" (S3 / R2 / MinIO) or "local" (dev only).
STORAGE_DRIVER=""
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ── Optional: enquiry email notifications (Resend) ─────────────────────
# Enquiries are always saved first; email is a notification only.
RESEND_API_KEY=""
NOTIFY_FROM=""
NOTIFY_TO="pintus781@gmail.com"
